# Copy to .env (same folder as run.py, or next to the desktop executable) and fill in.
# .env is git-ignored. Never commit real credentials.

# ---- Mode ----
# true  = synthetic, clearly-labelled DEMO data (safe for development)
# false = live data from MARKET_DATA_PROVIDER (requires credentials below)
DEMO_MODE=true
# When live calls fail, serve labelled DEMO data instead of an error. Keep false unless you want this.
DEMO_FALLBACK=false
MARKET_DATA_PROVIDER=samco

# ---- SAMCO StockNote API (live market data) ----
SAMCO_USER_ID=
SAMCO_PASSWORD=
SAMCO_YOB=
SAMCO_BASE_URL=https://api.stocknote.com
SAMCO_TIMEOUT_SECONDS=10
SAMCO_MAX_CONCURRENCY=3

# ---- AI (Claude). Leave the key empty to use the built-in rule-based interpreter. ----
ANTHROPIC_API_KEY=
AI_ENABLED=true
AI_MODEL=claude-opus-5-5
AI_EFFORT=medium

# ---- Server ----
HOST=127.0.0.1
PORT=8000
# Extra allowed browser origins (comma separated). Defaults cover localhost and the Android app.
CORS_ORIGINS=

# ---- Risk defaults (can be overridden per request / in the app's Settings) ----
DEFAULT_CAPITAL=500000
DEFAULT_RISK_PCT=1
MAX_POSITION_PCT=20

# ---- Analysis ----
# Timeframes analysed for the watchlist. Fewer = faster first load on live data (1d is always included).
WATCHLIST_TIMEFRAMES=1d,1h,15m,5m
CACHE_TTL_SECONDS=60
# Fundamentals / news / FII-DII / F&O OI for LIVE mode (see data/reference_live.example.json)
REFERENCE_DATA_FILE=
UNIVERSE_FILE=
USER_WATCHLIST_FILE=
